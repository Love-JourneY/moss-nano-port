#!/bin/bash
# ══════════════════════════════════════════════════════════════════════
# vsay-android-play —— 把 wav 交给 Android 侧播放（格仔/平板 chroot 唯一出声通路）
# ══════════════════════════════════════════════════════════════════════
# 【为什么需要它】
#   平板 chroot 里【没有任何】能出声的本地播放器（2026-09-22 逐条实测否掉）：
#     · pacat / paplay ⇒ 没有 PulseAudio 服务端可连（chroot 与 Android 都没有）
#     · pw-play        ⇒ pw_context_connect() failed: Host is down（没有 PipeWire 守护）
#     · aplay          ⇒ pcm_write: write error: Invalid argument
#                        （Android 音频 HAL / ohalservice.qti 独占 /dev/snd）
#     · tinyplay       ⇒ Error playing sample
#   唯一被系统放行的通路 = Android 侧一个 @android:style/Theme.NoDisplay 的 Activity：
#       com.fcitx5sensevoice/.SpeakTriggerActivity  --es wav_path <路径>
#   （NoDisplay ⇒ **不创建 window**；2026-09-22 已用 mCurrentFocus 证明播放前后焦点都不是它。）
#   ⇒ 本脚本的外形是"一个 chroot 播放器"，内里把活交给 Android。
#
# 【为什么做成 shim，而不是改 vsay-canto】
#   vsay-canto 的 pick_player() 已经支持 VSAY_CANTO_PLAYER 覆盖（第一优先级）。
#   借这个**既有钩子** ⇒ 平板上的 vsay-canto 与黑仔保持【字节一致】（md5 8071d81b），
#   不产生第二份分叉、不引入实现漂移。这是最小改动 + 最大化复用的选择。
#   （不过本机实际是由 /usr/local/bin/vsay 直接调用本脚本 —— 见那边的注释。）
#
# 【为什么走 andro，而不是直接跑 am】
#   chroot 里跑不了 Android 二进制（glibc / linker64 不兼容），`am` 根本不在 chroot 里。
#   `andro` 是平板既有的 chroot→Android FIFO 桥（实测往返 0.26s）。
#
# ⚠️ 重要约束（踩过，别绕过）
#   SpeakTriggerActivity **一次只吃一个 wav 文件**（女声源码 line 1122 明载）。
#   连续 am start 多段 ⇒ 后一段打断前一段 ⇒ 只会听到最后一段。
#   ⇒ 调用方必须【先把多段拼成一个 wav】再交给本脚本。
#     /usr/local/bin/vsay 已按此实现（合成侧 -o/--out 拼接）。
#
# 用法（一般由 /usr/local/bin/vsay 调用，不用手敲）：
#   vsay-android-play /tmp/xxx.wav
# 出口码：0 = 已交给 Android 播放；非 0 = 交不出去（调用方会如实报错，不静默）
# ══════════════════════════════════════════════════════════════════════
set -uo pipefail

# 显式 PATH:本脚本可能被非登录上下文调用(DSH / vsay-canto 的 VSAY_CANTO_PLAYER 钩子),
# 那种情况下 /etc/profile.d 不生效 ⇒ find/chown/cp/andro 全都找不到。
export PATH=/usr/local/bin:/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin

WAV="${1:-}"
if [ -z "$WAV" ] || [ ! -f "$WAV" ]; then
  echo "vsay-android-play: 找不到 wav 文件: '${WAV}'" >&2
  exit 2
fi

# ── App 私有外部目录 ────────────────────────────────────────────────
# Android 与 chroot 看到的是【同一 inode】，只是路径不同：
#   Android 侧 /sdcard/Android/data/<pkg>/files
#   chroot  侧 /android/data/media/0/Android/data/<pkg>/files
# ⚠️ 必须放 App **私有外部目录**，不能放 /sdcard/Documents ——
#    Android 11+ scoped storage 下 App 读 Documents 会 EACCES(errno 13)。
APP_PKG=com.fcitx5sensevoice
DIR_CHROOT="/android/data/media/0/Android/data/$APP_PKG/files"
DIR_ANDROID="/sdcard/Android/data/$APP_PKG/files"
# ⚠️ 必须改属主：不改的话 App(另一个 uid) 读不到 ⇒ 静默没声（踩过）。
#    实测该 App uid:gid = 10379:1078（u0_a379:ext_data_rw）。
APP_UIDGID=10379:1078
COMPONENT="$APP_PKG/.SpeakTriggerActivity"

if [ ! -d "$DIR_CHROOT" ]; then
  echo "vsay-android-play: App 共享目录不存在: $DIR_CHROOT" >&2
  exit 3
fi

# ── 自清理：只删【本脚本自己生成】的旧 wav（前缀 vsay-android-），且只删 5 分钟前的 ──
# 为什么用 find -mmin 而不是「后台 sleep 后 rm」：不留后台进程、不依赖任务调度、零残留。
# ⚠️ 绝不碰该目录里其它任何文件（别的工具 / 别的 agent 的产物一律不动）。
find "$DIR_CHROOT" -maxdepth 1 -name 'vsay-android-*.wav' -mmin +5 -delete 2>/dev/null

BASENAME="vsay-android-$(date +%s)-$$.wav"
DST="$DIR_CHROOT/$BASENAME"
if ! cp -f "$WAV" "$DST" 2>/dev/null; then
  echo "vsay-android-play: 落盘到 App 共享目录失败: $DST" >&2
  exit 4
fi
chown "$APP_UIDGID" "$DST" 2>/dev/null    # 失败不致命（可能本来就对）
chmod 664 "$DST" 2>/dev/null

# ── 交给 Android 播 ────────────────────────────────────────────────
if ! command -v andro >/dev/null 2>&1; then
  echo "vsay-android-play: 缺 andro 桥（Android 执行器 p2p-android-exec 没在跑？）" >&2
  echo "vsay-android-play: wav 已落盘，可手工播：am start --activity-single-top -n $COMPONENT --es wav_path $DIR_ANDROID/$BASENAME" >&2
  exit 5
fi

andro "am start --activity-single-top -n $COMPONENT --es wav_path $DIR_ANDROID/$BASENAME" >/dev/null 2>&1
rc=$?
if [ "$rc" -ne 0 ]; then
  echo "vsay-android-play: Android 触发失败（andro 出口码=$rc）" >&2
  echo "vsay-android-play: wav 已落盘：$DIR_ANDROID/$BASENAME" >&2
  exit 6
fi

# ⚠️ 注意：am start 是【异步】的 —— 本脚本返回不代表已经播完。
#    所以**不能**在这里删 wav（会切掉正在播的音频）；留给上面的 5 分钟自清理。
exit 0
