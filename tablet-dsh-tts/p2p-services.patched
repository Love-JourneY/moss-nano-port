#!/bin/bash
# p2p-services —— chroot 内服务管理（sshd:2222 / dinotty:8999 / dsh:3080）幂等
# 用法: p2p-services {start|stop|status|restart}
set -u
SSHD_PORT=${SSHD_PORT:-2222}
# dinotty 取代 ttyd（2026-09-19，Nija 定：ttyd 完全退役）：dinotty 功能是 ttyd 的超集
# （服务端 VTE / PTY 断连不丢 / 分屏 / 文件浏览 / Web 预览）。二进制由 ~/Documents/repo/dinotty 模块装。
DINOTTY_PORT=${DINOTTY_PORT:-8999}
DINOTTY_BIN=${DINOTTY_BIN:-/opt/dinotty/usr/bin/dinotty-server}
DINOTTY_ENV=${DINOTTY_ENV:-/etc/dinotty/env}
DSH_PORT=${DSH_PORT:-3080}                      # 平板本地 DSH agent（2026-09-19 接入）
DSH_HOME_DIR=${DSH_HOME_DIR:-/root/.dsh}
DSH_LOG=/var/log/dsh-pad.log
RUN=/run
DSH_PID=$RUN/dsh.pid                             # 必须在 RUN 之后（set -u）
mkdir -p "$RUN/sshd"

# 端口检测：读 /proc/net/tcp（trixie-slim 无 ss/iproute2 → 零依赖方案）
is_listen() {
  # ① 端口表：**必须同时校验 本地地址列($2) + LISTEN 状态($4=="0A")**。
  #    旧写法 `grep -qiE ":PORT "` 只看端口号 ⇒ 刚断开的连接的 TIME_WAIT/FIN_WAIT
  #    残留条目也算命中，被判成"仍在监听"。
  #    2026-09-18 修好 /proc 幽灵挂载后这条路**首次真正生效**，立刻暴露该缺陷：
  #    stop 后 start 误报"sshd 已在 :2222 监听" ⇒ 跳过拉起 ⇒ 服务永久停摆
  #    （实测日志：`sshd 已在 :2222 监听` 紧跟 `2222 端口: 断`），直到 TIME_WAIT 过期。
  _hex=$(printf '%04X' "$1" 2>/dev/null)
  [ -n "$_hex" ] && awk -v p=":$_hex" \
      '$2 ~ p"$" && $4 == "0A" {f=1} END{exit !f}' \
      /proc/net/tcp /proc/net/tcp6 2>/dev/null && return 0
  # ② 直接连一下（最可靠；bash 的 /dev/tcp）
  bash -c "exec 3<>/dev/tcp/127.0.0.1/$1" 2>/dev/null && return 0
  # ③ 退到进程检查
  case "$1" in
    "$SSHD_PORT") ps -eo args 2>/dev/null | grep -F -- "sshd -p $SSHD_PORT" | grep -v grep >/dev/null && return 0 ;;
  esac
  return 1
}

pid_alive() { [ -f "$1" ] && kill -0 "$(cat "$1" 2>/dev/null)" 2>/dev/null; }

start_sshd() {
  if is_listen "$SSHD_PORT"; then echo "  sshd 已在 :$SSHD_PORT 监听"; return 0; fi
  /usr/sbin/sshd -p "$SSHD_PORT"
  sleep 1
  is_listen "$SSHD_PORT" && echo "  ✅ sshd 启动 :$SSHD_PORT" || echo "  ❌ sshd 启动失败（看 /var/log/auth.log）"
}
# ── dinotty（取代 ttyd，2026-09-19 Nija 定：ttyd 完全退役）─────────────
# dinotty 只能绑 0.0.0.0：**它没有绑地址开关**（只接受纯整数端口；实测
#   `--port 127.0.0.1:8999` → invalid port number）⇒ 要"只回环可达"只能靠防火墙。
# 规则由**开机钩子**在 Android 侧施加（chroot 跑不了 Android 二进制：
#   `/android/system/bin/iptables` 会 `required file not found`），这里只做兜底补刀。
apply_dinotty_firewall() {
  andro "/system/bin/iptables -S INPUT 2>/dev/null | grep -q -- '--dport $DINOTTY_PORT'" >/dev/null 2>&1 && return 0
  if andro "/system/bin/iptables -I INPUT 1 -p tcp --dport $DINOTTY_PORT ! -i lo -j DROP" >/dev/null 2>&1; then
    echo "  🔒 已限制 :$DINOTTY_PORT 仅回环可达（经 andro 桥）"
  else
    echo "  ⚠️ 未能施加 :$DINOTTY_PORT 仅回环规则（下次开机会由钩子重试）"
  fi
}
start_dinotty() {
  [ -x "$DINOTTY_BIN" ] || { echo "  ⬜ dinotty 未安装，跳过（安装见 ~/Documents/repo/dinotty）"; return 0; }
  if is_listen "$DINOTTY_PORT"; then echo "  dinotty 已在 :$DINOTTY_PORT 监听"; apply_dinotty_firewall; return 0; fi
  [ -f "$DINOTTY_ENV" ] && { set -a; . "$DINOTTY_ENV" 2>/dev/null; set +a; }
  (
    export HOME=/root SHELL=/bin/bash PATH=/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
    setsid "$DINOTTY_BIN" --port "${DINOTTY_PORT:-8999}" >/var/log/dinotty.log 2>&1 &
    echo $! > "$RUN/dinotty.pid"
  )
  sleep 6
  # 防火墙**无条件**施加（不依赖"是否已在监听"）：规则管的是端口，
  # dinotty 启动慢一点也不该留口子 —— 健壮性优先（早堵晚堵，不能漏）。
  apply_dinotty_firewall
  if is_listen "$DINOTTY_PORT"; then
    echo "  ✅ dinotty 启动 :$DINOTTY_PORT（入口 http://127.0.0.1:$DINOTTY_PORT；token 在 $DINOTTY_ENV）"
  else
    echo "  ❌ dinotty 启动失败："; tail -5 /var/log/dinotty.log 2>/dev/null | sed 's/^/     /'
  fi
}
stop_dinotty() {
  local stopped=0
  pid_alive "$RUN/dinotty.pid" && kill "$(cat "$RUN/dinotty.pid")" 2>/dev/null && stopped=1
  pkill -f 'dinotty-server' 2>/dev/null && stopped=1
  # ttyd 已退役：顺手清掉可能残留的旧进程（幂等，防"退役了还在跑"）
  pkill -f '/usr/local/bin/ttyd' 2>/dev/null && stopped=1 && echo "  （顺带清掉残留的 ttyd 进程）"
  rm -f "$RUN/dinotty.pid" "$RUN/ttyd.pid"
  [ "$stopped" = 1 ] && echo "  dinotty 已停" || echo "  dinotty 未运行"
}
# ── 平板本地 DSH agent（2026-09-19 接入；Nija 定：key 留本地 + 开机自启 = 真自治）──
# 为什么本地 key：只骑 /mnt/bbSoyArch 的 sshfs 取 key 时，笔记本不在线/未挂载就没 key
#   ⇒ 不满足"平板自治"。故在 $DSH_HOME_DIR/dsh.env 留一份（600，与笔记本同内容）。
#   轮换秘密时要**两处一起换**（笔记本 ~/.dsh/dsh.env + 平板 /root/.dsh/dsh.env）。
# 权限档：默认 danger-full-access（与笔记本一致）。要收紧到 workspace-write 前必须先实测
#   本内核 bwrap/Landlock 可用性 —— 上游 sandbox 是 fail-closed，不可用会直接拒绝执行。
start_dsh() {
  [ -x /usr/local/bin/dsh ] || { echo "  ⬜ dsh 未安装，跳过"; return 0; }
  if is_listen "$DSH_PORT"; then echo "  dsh 已在 :$DSH_PORT 监听"; return 0; fi
  [ -f "$DSH_HOME_DIR/dsh.env" ] && { set -a; . "$DSH_HOME_DIR/dsh.env" 2>/dev/null; set +a; }
  (
    export HOME=/root DSH_HOME="$DSH_HOME_DIR" BROWSER=true \
           DSH_PERMISSION_MODE="${DSH_PERMISSION_MODE:-danger-full-access}" \
           PATH=/usr/local/bin:/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin
    setsid /usr/local/bin/dsh web --host 127.0.0.1 --port "$DSH_PORT" --no-open >"$DSH_LOG" 2>&1 &
    echo $! > "$DSH_PID"
  )
  sleep 12
  if is_listen "$DSH_PORT"; then
    echo "  ✅ dsh 启动 :$DSH_PORT（本地 agent；入口 token 见 $DSH_LOG）"
  else
    echo "  ❌ dsh 启动失败："; tail -5 "$DSH_LOG" 2>/dev/null | sed 's/^/     /'
    tail -30 "$DSH_LOG" >> /var/log/dsh-pad-fail.log 2>/dev/null   # 失败原因落盘，供事后查
  fi
}

stop_dsh() {
  local stopped=0
  pid_alive "$DSH_PID" && kill "$(cat "$DSH_PID")" 2>/dev/null && stopped=1
  # 模式兜底。注意：模式不得出现在本函数调用者的 cmdline 里（pkill -f 会自杀，见 lessons 23）
  # 2026-09-22 修：旧模式 '/usr/local/bin/dsh web' 与实际 cmdline（/opt/node-*/bin/dsh web）对不上 ⇒ 旧进程杀不掉
  # 导致重复实例、日志 token 属于没抢到端口的那个 ⇒ 认证永远 401。用括号模式避免自匹配（lessons 23）。
  for pid in $(pgrep -f '[d]sh web --host 127.0.0.1' 2>/dev/null); do kill "$pid" 2>/dev/null && stopped=1; done
  rm -f "$DSH_PID"
  [ "$stopped" = 1 ] && echo "  dsh 已停" || echo "  dsh 未运行"
}

# ── 笔记本 $HOME 只读挂载：**已整段移交 dsh-mesh（2026-09-22）** ──────────
# 这里原本有一套自研的 sshfs 挂载（2026-09-17 建；含 MAC 解析 / stale 自愈 / stat 判定）。
# 2026-09-20 dsh-mesh 落地后，**同一个 /mnt/bbSoyArch 变成两套机制抢**：
#   · dsh-mesh 才是三机文件网格的正主（模块化可迁移；7 栏 peers.conf 含 MAC；lib/mac-resolve.sh）
#   · 两套共用挂载点的实测后果：`p2p-services stop` 会把 dsh-mesh 的挂载一起拆掉（误伤过一次）
# ⇒ 按 Nija 的熵减 / 单一事实源原则，**本段已移除，挂载交还 dsh-mesh**
#   （/etc/init.d/dsh-mesh → /usr/local/bin/dsh-mesh mount）。
# 本文件此后**只管**：sshd(:2222) / dinotty(:8999) / 平板本地 dsh(:3080)。
# 历史与设计依据：~/Documents/system-maintenance/notes/2026-09-17-pad2pro-fs-sharing-plan.md

stop_all() {
  pkill -f 'sshd -p '"$SSHD_PORT" 2>/dev/null && echo "  sshd 已停" || echo "  sshd 未运行"
}
status() {
  echo "  端口状态:"
  is_listen "$SSHD_PORT" && echo "    ✅ sshd :$SSHD_PORT" || echo "    ⬜ sshd :$SSHD_PORT"
  is_listen "$DINOTTY_PORT" && echo "    ✅ dinotty :$DINOTTY_PORT（网页终端 IDE，仅回环）" || echo "    ⬜ dinotty :$DINOTTY_PORT"
  # /mnt/bbSoyArch 已移交 dsh-mesh（本文件不再管）—— 它的状态跑：dsh-mesh status
  is_listen "$DSH_PORT" && echo "    ✅ dsh  :$DSH_PORT（平板本地 agent）" || echo "    ⬜ dsh  :$DSH_PORT"
  /etc/init.d/dsh-tts status 2>/dev/null | sed "s/^/  /"   # dsh-tts 模块登记（DSH 🔊）
  echo "  进程:"; ps -eo pid,args 2>/dev/null | grep -E "sshd|dinotty|dsh web" | grep -v grep || echo "    （无）"
  echo "  说明: 端口判定 = /proc/net/tcp 的 LISTEN 条目（本地地址列 + st==0A）→ 再退回 /dev/tcp 直连探测"
}
# ⚠️⚠️ 2026-09-22 修复（格仔 TTS 对接时发现，别改回去）:
#   原先 start)/stop) 两行长这样:
#       start)  echo "启动服务:"; /etc/init.d/port-gate start ... || true  # port-gate（模块登记） start_sshd; start_dinotty; start_dsh ;;
#   那条 `#` 注释被插在了 `# port-gate（...）` 的**位置上** —— 但它后面紧跟着
#   `start_sshd; start_dinotty; start_dsh` ⇒ **整串被注释吞掉**。
#   ⇒ `p2p-services start` 实际只起了 port-gate，sshd/dinotty/dsh 一个都没起。
#   现象：重启平板后 :2222 / :8999 / :3080 全都不在（本次是因为它们从上次开机一直
#        活着、从没被 stop 过，才看起来"还在"）。`restart)` 那一行没被吞 ⇒ 只有
#        restart 能起来，所以故障很隐蔽。
#   修法：把 port-gate 的说明挪到行尾注释，恢复被吞的调用；并**登记 dsh-tts(:8790)**
#        —— DSH 的 🔊 按钮靠它出声（它不在时客户端会静默退回浏览器/系统 TTS）。
case "${1:-}" in
  start)
    echo "启动服务:"
    /etc/init.d/port-gate start >/dev/null 2>&1 || true   # port-gate 模块登记
    start_sshd; start_dinotty; start_dsh
    /etc/init.d/dsh-tts start                             # dsh-tts 模块登记（DSH 🔊 → canto-tts）
    ;;
  stop)
    echo "停止服务:"
    /etc/init.d/dsh-tts stop
    /etc/init.d/port-gate stop >/dev/null 2>&1 || true    # port-gate 模块登记
    stop_dsh; stop_dinotty; stop_all
    ;;
  restart)
    echo "重启服务:"
    /etc/init.d/dsh-tts stop
    stop_dsh; stop_dinotty; stop_all
    start_sshd; start_dinotty; start_dsh
    /etc/init.d/dsh-tts start
    ;;
  status)  status ;;
  *) echo "用法: $0 {start|stop|restart|status}"; exit 2 ;;
esac
